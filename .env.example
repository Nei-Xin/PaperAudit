HY3_API_BASE=https://your-hy3-api.example/v1
HY3_API_KEY=replace-with-your-local-key
HY3_MODEL=hy3

# Optional runtime settings
HY3_REASONING_EFFORT=no_think
HY3_TEMPERATURE=0.2
HY3_TOP_P=1.0
HY3_TIMEOUT_SECONDS=120
PAPERAUDIT_TOP_K=5
PAPERAUDIT_MAX_PAPER_CHARS=120000
PAPERAUDIT_JUDGE_BATCH_SIZE=6

