HY3_API_BASE=https://your-hy3-api.example/v1
HY3_API_KEY=replace-with-your-local-key
HY3_MODEL=hy3

# Where projects are stored (absolute path; created if missing)
PAPERAUDIT_STORAGE_ROOT=/absolute/path/to/paperaudit-data

# Optional runtime settings
HY3_REASONING_EFFORT=no_think
HY3_TEMPERATURE=0.2
HY3_TOP_P=1.0
HY3_TIMEOUT_SECONDS=120
PAPERAUDIT_TOP_K=5
PAPERAUDIT_MAX_PAPER_CHARS=120000
PAPERAUDIT_JUDGE_BATCH_SIZE=6
# Parallel claims per audit job in the app (1 = serial)
PAPERAUDIT_AUDIT_CONCURRENCY=4
# Optional automatic investigation of unresolved claims (default: standard audit)
PAPERAUDIT_DEEP_AUDIT=false
# Optional multi-step investigation for code and paper-code questions (default: single retrieval)
PAPERAUDIT_CODE_AGENT=false
# Paper-code consistency audit: total model requests per report and parallel investigations
PAPERAUDIT_CONSISTENCY_MAX_REQUESTS=160
PAPERAUDIT_CONSISTENCY_CONCURRENCY=4

# Semantic evidence verification for tool-based paper/code follow-up questions.
# Consistency audits always verify findings. Adds at most one request per investigation.
PAPERAUDIT_CODE_VERIFICATION=false
