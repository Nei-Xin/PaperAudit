!docs/typical_cases.md
!docs/demo_script.md
!docs/demo/
docs/demo/*
!docs/demo/paperaudit-demo.mp4
!docs/demo/paperaudit-overview.png

# Evaluation source, manifests and fixed JSONL samples remain visible. Large
# paper PDFs and exploratory/generated runs are local-only; only the compact
# frozen release artifacts below are kept as submission candidates.
eval/papers/
eval/v2_diagnostics/
eval/predictions/
eval/production_observations_v1/
eval/production_batch_*_result.json
eval/epikt_stage9_real*.json
eval/stage9_*_real*/
eval/results*/
!eval/results_final_holdout_actual/
!eval/results_final_holdout_actual/**
!eval/results_regression_v1_release/
!eval/results_regression_v1_release/**
!eval/results_error_type_v2_regression_actual_20260904/
!eval/results_error_type_v2_regression_actual_20260904/**
eval/validation*/
!eval/validation_full/
!eval/validation_full/**
!eval/validation_adversarial/
!eval/validation_adversarial/**

# Local dated Hy3/Luna experiment workspaces (existing tracked release snapshots
# remain versioned). Put new ad-hoc runs under tmp/experiments/.
eval/hy3_*_20*/
eval/luna_*_20*/
eval/luna_migration_smoke/
eval/**/*_checkpoints/
eval/**/*.log
eval/**/*.lock
