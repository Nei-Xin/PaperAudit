{
  "name": "paperaudit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCK=1 vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test:layout": "playwright test",
    "gen:api": "cd .. && uv run --locked python scripts/export_openapi.py && cd web && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "test:reading": "playwright test --config playwright.workflow.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.0",
    "clsx": "2.1.1",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-pdf": "9.1.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "openapi-typescript": "7.10.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
